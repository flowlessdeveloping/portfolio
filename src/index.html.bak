<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Davide Valenti — Senior Frontend Developer</title>
    <meta
      name="description"
      content="Davide Valenti — Senior Frontend Developer based in Palermo, Italy. Angular and React specialist with professional Java backend experience."
    />
    <meta name="author" content="Davide Valenti" />
    <meta name="theme-color" content="#0a0e17" />

    <meta property="og:type" content="profile" />
    <meta
      property="og:title"
      content="Davide Valenti — Senior Frontend Developer"
    />
    <meta
      property="og:description"
      content="Angular and React specialist with professional Java backend experience. Palermo, Italy."
    />
    <meta property="og:image" content="assets/img/profile.png" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/x-icon" href="favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Davide Valenti",
        "jobTitle": "Senior Frontend Developer",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Palermo",
          "addressCountry": "IT"
        },
        "sameAs": ["https://www.linkedin.com/in/davide-valenti-95b7a1133/"]
      }
    </script>

    <!-- Apply the stored theme before first paint so there is no flash. -->
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("cv.theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* keep the dark default */
        }
      })();
    </script>
  </head>
  <body>
    <app-root></app-root>
  </body>
</html>
